# Database Configuration (Default: PostgreSQL 16 + pgvector in Docker Compose)
DATABASE_URL=postgresql+psycopg://his_user:his_pass@db:5432/his_db

# Sample HIS Staging Repository Path & Target Branch
HIS_REPO_PATH=./sample_data/his_staging
HIS_STAGING_BRANCH=staging

# Adapter Providers (mock implementations behind interfaces, no external API keys required)
LLM_PRIMARY_PROVIDER=primary-mock
LLM_FALLBACK_PROVIDER=fallback-mock
LLM_SIMULATE_PRIMARY_FAILURE=false
JIRA_PROVIDER=mock
DISCORD_PROVIDER=mock
GIT_PROVIDER=local-repo

# Monthly LLM Quota Governance (Token & Cost USD ceilings per User and per Role)
MONTHLY_USER_TOKEN_QUOTA=50000
MONTHLY_USER_COST_USD_QUOTA=5.00
MONTHLY_ROLE_TOKEN_QUOTA=150000
MONTHLY_ROLE_COST_USD_QUOTA=15.00

# Durable Asyncio Worker Settings
WORKER_POLL_INTERVAL_SECONDS=0.2
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=3
ENABLE_BACKGROUND_WORKER=true
